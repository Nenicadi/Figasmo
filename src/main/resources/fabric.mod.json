{
  "schemaVersion": 1,
  "id": "figasmo",
  "version": "${version}",
  "license": "MIT",
  "name": "Figasmo",
  "description": "Integration between Figura and Voice!",
  "icon": "assets/figasmo/icon.png",
  "mixins": [
    "figasmo.mixins.json"
  ],
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.nenicadi.figasmo.Figasmo"
      }
    ],
    "voicechat": [
      {
        "adapter": "kotlin",
        "value": "dev.nenicadi.figasmo.modules.SimpleVoiceAddon"
      }
    ],
    "figura_api": [
      {
        "adapter": "kotlin",
        "value": "dev.nenicadi.figasmo.FigasmoAddon"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "figura": ">=${figura_version}"
  },
  "authors": [ "Nenicadi" ],
  "contact": {
    "homepage": "https://t.me/ashesom",
    "sources": "https://github.com/Nenicadi/Figasmo",
    "issues": "https://github.com/Nenicadi/Figasmo/issues"
  }
}
